<BaseLayout sideBarActiveItemID="home">
  <div class="mt-16 mb-20 max-w-lg">
    <div class="w-16 h-1 bg-neutral mb-8"></div>

    <div class="text-5xl font-bold leading-tight">Agueda Schwartz</div>
    <div class="text-xl mt-3 opacity-70 leading-relaxed">
      AI Product Builder<br />
      📍 Queens, NY
