---
const { title, img, desc, url, badge, tags, pubDate, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";

const tagColors: Record<string, string> = {
  methods: "bg-blue-50 text-blue-700 border-blue-200",
  experiments: "bg-amber-50 text-amber-700 border-amber-200",
  failures: "bg-purple-50 text-purple-700 border-purple-200",
  signals: "bg-emerald-50 text-emerald-700 border-emerald-200",
};
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{desc}</p>
        <div class="card-actions justify-end items-center">
          {pubDate && (
            <div class="text-xs opacity-50 mr-auto">
              {new Date(pubDate).toLocaleDateString("en-US", { year: "numeric", month: "long" })}
            </div>
          )}
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class:list={["badge border", tagColors[tag] || "badge-outline"]}>
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
