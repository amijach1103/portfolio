---
const { title } = Astro.props;
---
<aside class="my-10 p-7 md:p-10 bg-base-100 rounded-lg border border-base-300 border-l-4 border-l-base-content/30 shadow-sm">
  {title && (
    <div class="font-mono text-xs uppercase tracking-[0.15em] opacity-50 mb-5 font-semibold">{title}</div>
  )}
  <div class="prose max-w-none">
    <slot />
  </div>
</aside>
